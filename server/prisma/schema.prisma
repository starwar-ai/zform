  processingOrderItemId String?              @map("processing_order_item_id")
  lineNumber            Int                  @map("line_number")
  inventoryInfo         String?              @map("inventory_info")
  productId             String?              @map("product_id")
  productCode           String?              @map("product_code")
  customerProductNo     String?              @map("customer_product_no")
  productName           String?              @map("product_name")
  quantity              Decimal              @default(0) @db.Decimal(10, 2)
  ratio                 Decimal?             @db.Decimal(5, 2)
  productImage          String?              @map("product_image")
  createdBy             String?              @map("created_by")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedBy             String?              @map("updated_by")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  deletedAt             DateTime?            @map("deleted_at")
  processingOrder       ProcessingOrder      @relation("ProcessingOrderSubItems", fields: [processingOrderId], references: [id], onDelete: Cascade)
  processingOrderItem   ProcessingOrderItem? @relation("ItemSubItems", fields: [processingOrderItemId], references: [id], onDelete: Cascade)

  @@index([processingOrderId])
  @@index([processingOrderItemId])
  @@index([productId])
  @@index([lineNumber])
  @@map("processing_order_sub_items")
}

model Quotation {
  id                  String          @id @default(cuid())
  code                String          @unique
  printStatus         PrintStatus     @default(NOT_PRINTED) @map("print_status")
  customerId          String          @map("customer_id")
  customerCode        String          @map("customer_code")
  customerName        String?         @map("customer_name")
  isNewCustomer       Boolean         @default(false) @map("is_new_customer")
  customerContactId   String?         @map("customer_contact_id")
  customerContactName String?         @map("customer_contact_name")
  countryId           String?         @map("country_id")
  countryName         String?         @map("country_name")
  internalCompanyId   String?         @map("internal_company_id")
  internalCompanyName String?         @map("internal_company_name")
  departurePortId     String?         @map("departure_port_id")
  departurePortName   String?         @map("departure_port_name")
  currency            String          @default("USD")
  priceTerms          String?         @map("price_terms")
  validUntil          DateTime?       @map("valid_until")
  salesPerson         String?         @map("sales_person")
  status              QuotationStatus @default(DRAFT)
  approvalStatus      ApprovalStatus  @default(PENDING) @map("approval_status")
  processInstanceId   String?         @map("process_instance_id")
  createdBy           String?         @map("created_by")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedBy           String?         @map("updated_by")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")
  items               QuotationItem[] @relation("QuotationItems")

  @@index([code])
  @@index([status])
  @@index([approvalStatus])
  @@index([customerId])
  @@index([createdAt])
  @@map("quotations")
}

model QuotationItem {
