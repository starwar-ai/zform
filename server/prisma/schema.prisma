// ============================================================
// 验货单 (Inspection Order)
// ============================================================

// 验货单状态
enum InspectionOrderStatus {
  DRAFT // 草稿
  PENDING_INSPECTION // 待验货
  INSPECTING // 验货中
  PASSED // 验货通过
  FAILED // 验货不通过
  PENDING_RESULT // 待定
  CANCELLED // 已取消
}

// 验货方式
enum InspectionMethod {
  DELIVERY_INSPECTION // 送货验收
  FULL_INSPECTION // 全检
  SAMPLING_INSPECTION // 抽检
  EXEMPT // 免检
}

// 分摊方式
enum AllocationMethod {
  BY_QUANTITY // 按数量分摊
  BY_AMOUNT // 按金额分摊
  BY_WEIGHT // 按重量分摊
  MANUAL // 手动分摊
}

// ==================== 验货单主表 ====================
model InspectionOrder {
  id String @id @default(cuid())

  // 基本信息
  code           String                @unique // 单号
  orderLinkCode  String?               @map("order_link_code") // 订单链路编号
  status         InspectionOrderStatus @default(DRAFT) // 验货单状态
  approvalStatus ApprovalStatus        @default(PENDING) @map("approval_status") // 审核状态

  // 人员信息
  buyer       String? // 采购员
  salesPerson String? @map("sales_person") // 业务员

  // 验货节点与结果
  inspectionNode    String? @map("inspection_node") // 验货节点
  resultAttachments Json?   @map("result_attachments") // 结果附件（JSON数组）
  images            Json? // 图片（JSON数组）

  // 重验单关联
  isReinspection             Boolean @default(false) @map("is_reinspection") // 是否重验单
  relatedInspectionOrderId   String? @map("related_inspection_order_id") // 关联验货单id
  relatedInspectionOrderCode String? @map("related_inspection_order_code") // 关联验货单单号

  // 来源信息
  sourceType           String? @map("source_type") // 单据来源
  purchaseContractId   String? @map("purchase_contract_id") // 采购合同主键
  purchaseContractCode String? @map("purchase_contract_code") // 采购合同编号

  // 仓库信息
  warehouseId   String? @map("warehouse_id") // 仓库主键
  warehouseName String? @map("warehouse_name") // 仓库名称

  // 验货方式
  inspectionMethod InspectionMethod? @map("inspection_method") // 验货方式

  // 供应商信息
  supplierId   String? @map("supplier_id") // 供应商id
  supplierCode String? @map("supplier_code") // 供应商编号
  supplierName String? @map("supplier_name") // 供应商名称

  // 申请验货信息
  expectedInspectionTime  DateTime? @map("expected_inspection_time") // 期望验货时间
  applicant               String? // 申请验货人
  applicantName           String?   @map("applicant_name") // 申请验货人姓名
  applicantDepartmentId   String?   @map("applicant_department_id") // 申请验货人部门主键
  applicantDepartmentName String?   @map("applicant_department_name") // 申请验货人部门名称

  // 计划验货信息
  plannedInspectionTime DateTime? @map("planned_inspection_time") // 计划验货时间
  factoryContact        String?   @map("factory_contact") // 工厂联系人
  contactPhone          String?   @map("contact_phone") // 联系电话
  inspectionAddress     String?   @map("inspection_address") // 验货地址

  // 验货人信息
  inspector               String? // 验货人
  inspectorName           String? @map("inspector_name") // 验货人姓名
  inspectorDepartmentId   String? @map("inspector_department_id") // 验货人部门主键
  inspectorDepartmentName String? @map("inspector_department_name") // 验货人部门名称

  // 实际验货
  actualInspectionTime DateTime? @map("actual_inspection_time") // 实际验货时间

  // 金额与分摊
  inspectionAmount Decimal?          @map("inspection_amount") @db.Decimal(15, 2) // 验货金额
  allocationMethod AllocationMethod? @map("allocation_method") // 分摊方式

  // 其他信息
  specialNotes     String? @map("special_notes") // 特别注意事项
  attachments      Json? // 附件（JSON数组）
  factoryGuarantee String? @map("factory_guarantee") // 工厂保函
  acceptanceNote   String? @map("acceptance_note") // 接受说明
  remark           String? // 备注

  // 归属公司
  companyId   String? @map("company_id") // 归属公司主键
  companyName String? @map("company_name") // 归属公司名称

  // 流程
  processInstanceId String? @map("process_instance_id") // 流程实例的编号

  // 时间戳
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // 关联关系
  items InspectionOrderItem[] @relation("InspectionOrderItems")

  @@index([code])
  @@index([status])
  @@index([approvalStatus])
  @@index([supplierId])
  @@index([purchaseContractId])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("inspection_orders")
}

// ==================== 验货单明细表 ====================
model InspectionOrderItem {
  id String @id @default(cuid())

  // 关联验货单
  inspectionOrderId String          @map("inspection_order_id")
