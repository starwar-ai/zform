  container40ft        Decimal?  @map("container_40ft") @db.Decimal(10, 2)
  container40hq        Decimal?  @map("container_40hq") @db.Decimal(10, 2)
  packageMethod        String?   @map("package_method")
  innerBoxQty          Decimal?  @map("inner_box_qty") @db.Decimal(10, 2)
  outerBoxQty          Decimal?  @map("outer_box_qty") @db.Decimal(10, 2)
  boxCount             Int?      @map("box_count")
  outerBoxUnit         String?   @map("outer_box_unit")
  outerBoxLength       Decimal?  @map("outer_box_length") @db.Decimal(10, 2)
  outerBoxWidth        Decimal?  @map("outer_box_width") @db.Decimal(10, 2)
  outerBoxHeight       Decimal?  @map("outer_box_height") @db.Decimal(10, 2)
  outerBoxVolume       Decimal?  @map("outer_box_volume") @db.Decimal(10, 3)
  outerBoxNetWeight    Decimal?  @map("outer_box_net_weight") @db.Decimal(10, 3)
  outerBoxGrossWeight  Decimal?  @map("outer_box_gross_weight") @db.Decimal(10, 3)
