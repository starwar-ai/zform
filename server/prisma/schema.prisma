  // 验货状态与描述
  inspectionStatus       InspectionStatus @default(NOT_INSPECTED) @map("inspection_status") // 验货状态
  failureDescription     String?          @map("failure_description") // 失败描述
  lastFailureDescription String?          @map("last_failure_description") // 上次失败描述
  pendingDescription     String?          @map("pending_description") // 待定描述

  // 数量与金额
  quantity          Decimal? @db.Decimal(10, 2) // 数量
  inspectionAmount  Decimal? @map("inspection_amount") @db.Decimal(15, 2) // 验货金额
  productTotalPrice Decimal? @map("product_total_price") @db.Decimal(15, 2) // 产品总价

  // 关联人员信息（冗余）
  buyerInfo        String? @map("buyer_info") // 采购员信息
  salesPersonInfo  String? @map("sales_person_info") // 销售员信息
  merchandiserInfo String? @map("merchandiser_info") // 跟单员信息
  customerInfo     String? @map("customer_info") // 客户信息

  // 包装信息
  outerBoxQuantity Int? @map("outer_box_quantity") // 外箱装量
  innerBoxQuantity Int? @map("inner_box_quantity") // 内盒装量
  boxCount         Int? @map("box_count") // 箱数

  // 备注
  remark String? // 备注

  // 时间戳
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([inspectionOrderId])
  @@index([skuId])
  @@index([inspectionStatus])
  @@index([lineNumber])
  @@map("inspection_order_items")
}

