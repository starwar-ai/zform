  @@index([sortOrder])
  @@index([createdAt])
  @@map("transport_methods")
}

model PurchasePaymentPlan {
  id                  String            @id @default(cuid())
  purchaseContractId  String            @map("purchase_contract_id")
  periodIndex         Int               @default(1) @map("step")
  paymentMethodType   Int?              @map("payment_method")
  paymentDescription  String?           @map("payment_name")
  paymentDateBase     Int?              @map("date_type")
  baseDate            DateTime?         @map("start_date")
  daysOffset          Int               @default(0) @map("days")
  expectedPaymentDate DateTime?         @map("expected_payment_date")
  paymentRatio        Decimal           @map("payment_ratio") @db.Decimal(19, 6)
  realPaymentRatio    Decimal?          @map("real_payment_ratio") @db.Decimal(19, 6)
  periodPayable       Decimal           @default(0) @map("payable_amount") @db.Decimal(15, 2)
  periodPaid          Decimal           @default(0) @map("paid_amount") @db.Decimal(15, 2)
  exeStatus           Int               @default(0) @map("exe_status")
  overdueStatus       Int               @default(0) @map("overdue_status")
  overdueDays         Int               @default(0) @map("overdue_days")
  earlyDays           Int               @default(0) @map("early_days")
  reminderStatus      Int               @default(0) @map("reminder_status")
  lastReminderAt      DateTime?         @map("last_reminder_at")
  reminderCount       Int               @default(0) @map("reminder_count")
  actualPaymentDate   DateTime?         @map("actual_payment_date")
  createdBy           String?           @map("created_by")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedBy           String?           @map("updated_by")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  deletedAt           DateTime?         @map("deleted_at")
  reminders           PaymentReminder[] @relation("PaymentPlanReminders")
  purchaseContract    PurchaseContract  @relation("PurchaseContractPaymentPlans", fields: [purchaseContractId], references: [id], onDelete: Cascade)

  @@index([purchaseContractId])
  @@index([periodIndex])
  @@index([expectedPaymentDate])
  @@index([exeStatus])
  @@index([overdueStatus])
  @@map("purchase_payment_plans")
}

model PaymentReminder {
  id                   String              @id @default(cuid())
  paymentPlanId        String              @map("payment_plan_id")
  purchaseContractId   String              @map("purchase_contract_id")
  purchaseContractCode String?             @map("purchase_contract_code")
  supplierId           String?             @map("supplier_id")
  supplierCode         String?             @map("supplier_code")
  supplierName         String?             @map("supplier_name")
  reminderType         Int                 @map("reminder_type")
  reminderDate         DateTime            @map("reminder_date")
  expectedDate         DateTime            @map("expected_date")
  payableAmt           Decimal             @map("payable_amt") @db.Decimal(15, 2)
  paidAmt              Decimal             @default(0) @map("paid_amt") @db.Decimal(15, 2)
  overdueDays          Int                 @default(0) @map("overdue_days")
  periodIndex          Int                 @default(1) @map("period_index")
  targetUserId         String?             @map("target_user_id")
  readStatus           Int                 @default(0) @map("read_status")
  handleStatus         Int                 @default(0) @map("handle_status")
  readAt               DateTime?           @map("read_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  paymentPlan          PurchasePaymentPlan @relation("PaymentPlanReminders", fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@index([paymentPlanId])
  @@index([purchaseContractId])
  @@index([supplierId])
  @@index([targetUserId])
  @@index([reminderType])
  @@index([readStatus])
  @@index([reminderDate])
  @@map("payment_reminders")
}

