// 数据源配置
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==================== 枚举定义 ====================

enum ProductType {
  STANDARD      // 标准产品
  CUSTOMER      // 客户产品
  SELF_OWNED    // 自营产品
}

enum ProductStatus {
  ACTIVE        // 活跃
  INACTIVE      // 停用
  DRAFT         // 草稿
  DISCONTINUED  // 停产
}

enum ApprovalStatus {
  PENDING       // 待审核
  APPROVED      // 已审核
  REJECTED      // 已拒绝
}

enum ChangeStatus {
  PENDING       // 待变更
  IN_PROGRESS   // 变更中
  COMPLETED     // 已完成
  CANCELLED     // 已取消
}

enum CompanyNature {
  FACTORY           // 工厂
  EXPORT_COMPANY    // 外销公司
  DOMESTIC_COMPANY  // 内销公司
  INTERNAL_CUSTOMER // 内部客户
}

enum PortStatus {
  NORMAL    // 正常
  SUSPENDED // 停运
}

// ==================== 子公司表 ====================

model Company {
  id                    String         @id @default(cuid())
  taxNumber             String?        @map("tax_number")              // 税号
  customsCode           String?        @map("customs_code")            // 海关编号
  officialSealImage     String?        @map("official_seal_image")     // 公章图片
  abbreviation          String?                                        // 简称
  isEnabled             Boolean        @default(true) @map("is_enabled") // 启用标识
  legalPerson           String?        @map("legal_person")            // 法人
  fax                   String?                                        // 企业传真
  phone                 String?                                        // 企业电话
  adminEmail            String?        @map("admin_email")             // 管理员邮箱
  adminMobile           String?        @map("admin_mobile")            // 管理员手机号
  adminName             String?        @map("admin_name")              // 管理员
  address               String?                                        // 企业地址
  addressEn             String?        @map("address_en")              // 企业英文地址
  businessLicenseNumber String?        @map("business_license_number") // 营业执照号
  businessLicenseImage  String?        @map("business_license_image")  // 营业执照
  nameEn                String?        @map("name_en")                 // 企业英文名称
  name                  String                                         // 企业名称
  nature                CompanyNature  @default(FACTORY)               // 公司性质
  unitAbbreviation      String?        @map("unit_abbreviation")       // 单位名称简称
  
  createdBy             String?        @map("created_by")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedBy             String?        @map("updated_by")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  deletedAt             DateTime?      @map("deleted_at")
  
  bankAccounts          CompanyBankAccount[]

  @@map("companies")
}

// ==================== 子公司银行账号表 ====================

model CompanyBankAccount {
  id                    String    @id @default(cuid())
  companyId             String    @map("company_id")
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAddress           String?   @map("bank_address")           // 银行地址
  companyNameCn         String?   @map("company_name_cn")        // 企业中文名称
  companyNameEn         String?   @map("company_name_en")        // 企业英文名称
  bankNameCn            String?   @map("bank_name_cn")           // 银行中文名称
  bankNameEn            String?   @map("bank_name_en")           // 银行英文名称
  bankAddressEn         String?   @map("bank_address_en")        // 银行英文地址
  accountNumber         String?   @map("account_number")         // 银行账号
  swiftCode             String?   @map("swift_code")             // 银行识别代码
  isDefault             Boolean   @default(false) @map("is_default") // 是否默认账户
  
  createdBy             String?   @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedBy             String?   @map("updated_by")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  @@index([companyId])
  @@map("company_bank_accounts")
}

// ==================== 区域表 ====================

model Region {
  id         String    @id @default(cuid())
  code       String    @unique               // 区域编码
  name       String                          // 区域名称

  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedBy  String?   @map("updated_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  
  countries  Country[]

  @@map("regions")
}

// ==================== 国家表 ====================

model Country {
  id           String    @id @default(cuid())
  name         String                          // 国家名称
  code         String    @unique               // 国家编码
  regionId     String?   @map("region_id")     // 区域id
  region       Region?   @relation(fields: [regionId], references: [id])
  
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedBy    String?   @map("updated_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  
  ports        Port[]

  @@index([regionId])
  @@map("countries")
}

// ==================== 港口表 ====================

model Port {
  id           String      @id @default(cuid())
  code         String      @unique               // 编号
  name         String                            // 名称
  nameEn       String?     @map("name_en")       // 英文名称
  countryId    String      @map("country_id")    // 国家id
  country      Country     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  city         String?                           // 城市
  address      String?                           // 地址
  isCommon     Boolean     @default(false) @map("is_common") // 常用标记
  status       PortStatus  @default(NORMAL)      // 状态
  
  createdBy    String?     @map("created_by")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedBy    String?     @map("updated_by")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  @@index([countryId])
  @@map("ports")
}

// ==================== 部门表 ====================

model Department {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  parentId  String?   @map("parent_id")
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentTree")
  orderNum  Int       @default(0) @map("order_num")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products  Product[]
  users     SysUser[] @relation("UserDepartment")

  @@index([parentId])
  @@map("departments")
}

// ==================== 品牌表 ====================

model Brand {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  nameEn         String?   @map("name_en")
  customerId     String?   @map("customer_id")
  customerCode   String?   @map("customer_code")
  customerName   String?   @map("customer_name")
  type           String?   // 品牌类型
  description    String?
  descriptionEn  String?   @map("description_en")
  isCommon       Boolean   @default(false) @map("is_common")
  isSelfOwned    Boolean   @default(false) @map("is_self_owned")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedBy      String?   @map("updated_by")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  products       Product[]

  @@map("brands")
}

// ==================== 产品分类表（支持多级）====================

model ProductCategory {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  level     Int       @default(1)
  parentId  String?   @map("parent_id")
  parent    ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProductCategory[] @relation("CategoryTree")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products  Product[]

  @@map("product_categories")
}

// ==================== 海关编码表 ====================

model HsCode {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  hsCode       String    @map("hs_code")
  categoryCode String?   @map("category_code")
  parentId     String?   @map("parent_id")
  parent       HsCode?   @relation("HsCodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     HsCode[]  @relation("HsCodeTree")
  type         String?
  level        Int       @default(1)
  serialLength Int       @default(6) @map("serial_length")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedBy    String?   @map("updated_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  products     Product[]

  @@map("hs_codes")
}

// ==================== 客户分类表（支持多级）====================

model CustomerCategory {
  id        String    @id @default(cuid())
  code      String    @unique                       // 分类编号
  name      String                                  // 名称
  parentId  String?   @map("parent_id")
  parent    CustomerCategory?  @relation("CustomerCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  CustomerCategory[] @relation("CustomerCategoryTree")

  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")            // 删除标志：null=有效

  @@index([parentId])
  @@map("customer_categories")
}

// ==================== 展会分类表 ====================

model ExhibitionCategory {
  id          String    @id @default(cuid())
  name        String                                // 名称
  isDomestic  Boolean   @default(false) @map("is_domestic")  // 是否国内系列（false：否 true：是）

  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedBy   String?   @map("updated_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")          // 删除标志：null=有效

  @@map("exhibition_categories")
}

// ==================== 客户来源表 ====================

model CustomerSourceTag {
  id        String    @id @default(cuid())
  code      String    @unique                        // 标签编码
  name      String                                // 标签名称
  isCommon  Boolean   @default(false) @map("is_common") // 是否常用

  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")          // 删除标志：null=有效

  @@map("customer_source_tags")
}

// ==================== 包装方式表 ====================

model PackageMethod {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  nameEn    String?   @map("name_en")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products  Product[]

  @@map("package_methods")
}

// ==================== 产品主表 ====================

model Product {
  id                String          @id @default(cuid())
  code              String          @unique
  barcode           String?
  name              String
  nameEn            String?         @map("name_en")

  // 产品类型与继承关系
  productType       ProductType     @default(STANDARD) @map("product_type")
  baseProductId     String?         @map("base_product_id")
  baseProduct       Product?        @relation("ProductInheritance", fields: [baseProductId], references: [id])
  derivedProducts   Product[]       @relation("ProductInheritance")

  // 客户信息（客户产品专用）
  customerId        String?         @map("customer_id")
  customerCode      String?         @map("customer_code")
  customerProductNo String?         @map("customer_product_no")

  // 自营产品信息
  selfOwnedProductNo String?        @map("self_owned_product_no")

  // 基本信息
  status            ProductStatus   @default(ACTIVE)
  description       String?
  descriptionEn     String?         @map("description_en")
  isSelfBrand       Boolean         @default(false) @map("is_self_brand")
  isAdvantage       Boolean         @default(false) @map("is_advantage")
  source            String?
  material          String?
  accessoryMaterial String?         @map("accessory_material")
  unit              String          @default("PCS")

  // 规格尺寸
  length            Decimal?        @db.Decimal(10, 2)
  width             Decimal?        @db.Decimal(10, 2)
  height            Decimal?        @db.Decimal(10, 2)
  netWeight         Decimal?        @db.Decimal(10, 3) @map("net_weight")

  // 价格与加工
  unitProcessingFee Decimal?        @db.Decimal(10, 2) @map("unit_processing_fee")
  processingNote    String?         @map("processing_note")
  salePrice         Decimal?        @db.Decimal(10, 2) @map("sale_price")
  companyPrice      Decimal?        @db.Decimal(10, 2) @map("company_price")

  // 报关信息
  isCustomsInspection Boolean       @default(false) @map("is_customs_inspection")
  customsNameCn     String?         @map("customs_name_cn")
  customsNameEn     String?         @map("customs_name_en")

  // 代理与通用辅料
  isAgent           Boolean         @default(false) @map("is_agent")
  isCommonAccessory Boolean         @default(false) @map("is_common_accessory")

  // 审核状态
  approvalStatus    ApprovalStatus  @default(PENDING) @map("approval_status")

  // 变更管理
  isChanged         Boolean         @default(false) @map("is_changed")
  changeStatus      ChangeStatus?   @map("change_status")
  changeDeleted     Boolean         @default(false) @map("change_deleted")
  version           Int             @default(1)
  impactScope       String?         @map("impact_scope")
  processModelId    String?         @map("process_model_id")

  // 附件与图片
  thumbnail         String?
  attachments       Json?           // JSON 数组存储附件 URL
  images            Json?           // JSON 数组存储图片 URL

  // 备注
  remark            String?
  autoCreated       Boolean         @default(false) @map("auto_created")
  customerProductId String?         @map("customer_product_id")

  // 关联关系
  departmentId      String?         @map("department_id")
  department        Department?     @relation(fields: [departmentId], references: [id])

  brandId           String?         @map("brand_id")
  brand             Brand?          @relation(fields: [brandId], references: [id])

  categoryId        String?         @map("category_id")
  category          ProductCategory? @relation(fields: [categoryId], references: [id])

  hsCodeId          String?         @map("hs_code_id")
  hsCode            HsCode?         @relation(fields: [hsCodeId], references: [id])

  packageMethodId   String?         @map("package_method_id")
  packageMethod     PackageMethod?  @relation(fields: [packageMethodId], references: [id])

  // BOM 关系（作为父产品）
  bomItems          ProductBom[]    @relation("ParentProduct")
  // BOM 关系（作为子产品）
  usedInBoms        ProductBom[]    @relation("ChildProduct")

  // 辅料关系
  accessories       ProductAccessory[] @relation("ProductAccessories")
  usedAsAccessory   ProductAccessory[] @relation("AccessoryProduct")

  // 变更记录
  changeLogs        ProductChangeLog[]

  // 时间戳
  createdBy         String?         @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedBy         String?         @map("updated_by")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  @@index([productType])
  @@index([status])
  @@index([baseProductId])
  @@index([customerId])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

// ==================== 产品 BOM 表 ====================

model ProductBom {
  id              String    @id @default(cuid())

  parentProductId String    @map("parent_product_id")
  parentProduct   Product   @relation("ParentProduct", fields: [parentProductId], references: [id], onDelete: Cascade)

  childProductId  String    @map("child_product_id")
  childProduct    Product   @relation("ChildProduct", fields: [childProductId], references: [id], onDelete: Cascade)

  quantity        Decimal   @db.Decimal(10, 3)
  version         Int       @default(1)
  productType     String?   @map("product_type")

  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedBy       String?   @map("updated_by")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@unique([parentProductId, childProductId])
  @@index([parentProductId])
  @@index([childProductId])
  @@map("product_boms")
}

// ==================== 产品辅料关联表 ====================

model ProductAccessory {
  id              String    @id @default(cuid())

  productId       String    @map("product_id")
  product         Product   @relation("ProductAccessories", fields: [productId], references: [id], onDelete: Cascade)

  accessoryId     String    @map("accessory_id")
  accessory       Product   @relation("AccessoryProduct", fields: [accessoryId], references: [id], onDelete: Cascade)

  productRatio    Decimal?  @db.Decimal(10, 3) @map("product_ratio")
  accessoryRatio  Decimal?  @db.Decimal(10, 3) @map("accessory_ratio")
  description     String?
  remark          String?

  isActive        Boolean   @default(true) @map("is_active")

  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedBy       String?   @map("updated_by")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@unique([productId, accessoryId])
  @@index([productId])
  @@index([accessoryId])
  @@map("product_accessories")
}

// ==================== 产品变更记录表 ====================

model ProductChangeLog {
  id          String    @id @default(cuid())

  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  version     Int
  changeType  String    @map("change_type") // CREATE, UPDATE, DELETE, STATUS_CHANGE 等
  fieldName   String?   @map("field_name")
  oldValue    String?   @map("old_value")
  newValue    String?   @map("new_value")
  description String?
  reason      String?

  changedBy   String    @map("changed_by")
  changedAt   DateTime  @default(now()) @map("changed_at")

  @@index([productId])
  @@index([changedAt])
  @@map("product_change_logs")
}

// ==================== 供应商相关枚举 ====================

enum SupplierType {
  MANUFACTURER      // 生产商
  TRADER           // 贸易商
  SERVICE_PROVIDER // 服务商
  LOGISTICS        // 物流商
  OTHER            // 其他
}

enum SupplierLevel {
  A  // A级
  B  // B级
  C  // C级
  D  // D级
}

enum SupplierStage {
  POTENTIAL  // 潜在供应商
  FORMAL     // 正式供应商
  RETIRED    // 退休供应商
}

enum InvoiceType {
  VAT_GENERAL    // 增值税专用发票
  VAT_SPECIAL    // 增值税普通发票
  ORDINARY       // 普通发票
  RECEIPT        // 收据
}

// ==================== 供应商主表 ====================

model Supplier {
  id                    String         @id @default(cuid())

  // 基本信息
  code                  String         @unique // 供应商编码
  name                  String         // 供应商名称
  nameEn                String?        @map("name_en") // 供应商英文名称
  shortName             String?        @map("short_name") // 供应商简称
  registeredCapital     Decimal?       @db.Decimal(15, 2) @map("registered_capital") // 注册资本
  legalRepresentative   String?        @map("legal_representative") // 法定代表人
  mainBusiness          String?        @map("main_business") // 主营业务
  payableSupplierCode   String?        @map("payable_supplier_code") // 应付供应商编号

  // 地址信息
  companyCity           String?        @map("company_city") // 公司所在城市
  factoryCity           String?        @map("factory_city") // 工厂所在城市
  expressCity           String?        @map("express_city") // 快递所在城市
  factoryAddress        String?        @map("factory_address") // 工厂地址
  companyAddress        String?        @map("company_address") // 公司地址
  expressAddress        String?        @map("express_address") // 快递地址

  // 证照信息
  businessLicenseNo     String?        @map("business_license_no") // 营业执照号
  companyPhone          String?        @map("company_phone") // 企业电话
  fax                   String?        // 传真

  // 分类与等级
  isOverseas            Boolean        @default(false) @map("is_overseas") // 是否境外供应商
  supplierType          SupplierType   @default(OTHER) @map("supplier_type") // 供应商类型
  supplierLevel         SupplierLevel? @map("supplier_level") // 供应商等级
  stage                 SupplierStage  @default(POTENTIAL) // 客户阶段

  // 财务信息
  countryCode           String?        @map("country_code") // 国家编号
  currency              String?        @default("CNY") // 币种
  taxRate               Decimal?       @db.Decimal(5, 2) @map("tax_rate") // 税率
  invoiceType           InvoiceType?   @map("invoice_type") // 发票类型

  // 业务信息
  buyerList             Json?          @map("buyer_list") // 采购员列表（JSON数组）
  buyer                 String?        // 主采购员
  adminSupplierType     String?        @map("admin_supplier_type") // 行政供应商类型

  // 标识字段
  isInternalEnterprise  Boolean        @default(false) @map("is_internal_enterprise") // 内部企业标识 0-否 1-是
  internalEnterprisePk  String?        @map("internal_enterprise_pk") // 内部企业主键
  isExpressCompany      Boolean        @default(false) @map("is_express_company") // 快递公司标记

  // 关联与资质
  qualificationIds      Json?          @map("qualification_ids") // 关联资质id（JSON数组）

  // 状态管理
  approvalStatus        ApprovalStatus @default(PENDING) @map("approval_status") // 审核状态
  isFormal              Boolean        @default(false) @map("is_formal") // 转正标识
  formalTime            DateTime?      @map("formal_time") // 转正时间
  isEnabled             Boolean        @default(true) @map("is_enabled") // 是否启用

  // 变更管理
  isChanged             Boolean        @default(false) @map("is_changed") // 是否变更
  changeStatus          ChangeStatus?  @map("change_status") // 变更状态
  changeDeleted         Boolean        @default(false) @map("change_deleted") // 变更是否删除
  version               Int            @default(1) // 版本号
  impactScope           String?        @map("impact_scope") // 影响范围
  processModelId        String?        @map("process_model_id") // 流程模型标识

  // 附件与备注
  attachments           Json?          // 附件（JSON数组）
  remark                String?        // 备注

  // 财务信息（JSON 对象）
  financialInfo         Json?          @map("financial_info") // 财务信息

  // 时间戳
  createdBy             String?        @map("created_by")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedBy             String?        @map("updated_by")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  deletedAt             DateTime?      @map("deleted_at")

  // 关联关系
  bankAccounts          SupplierBankAccount[]
  quotations            SupplierQuotation[]

  @@index([code])
  @@index([stage])
  @@index([supplierType])
  @@index([approvalStatus])
  @@map("suppliers")
}

// ==================== 供应商银行账户信息表 ====================

model SupplierBankAccount {
  id              String    @id @default(cuid())

  supplierId      String    @map("supplier_id")
  supplier        Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  supplierVersion Int       @map("supplier_version") // 供应商版本
  bankName        String    @map("bank_name") // 银行
  accountNumber   String    @map("account_number") // 银行账号
  branchAddress   String?   @map("branch_address") // 开户行地址
  branchContact   String?   @map("branch_contact") // 开户行联系人
  bankCode        String?   @map("bank_code") // 银行行号
  isDefault       Boolean   @default(false) @map("is_default") // 是否默认账号

  version         Int       @default(1) // 版本

  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedBy       String?   @map("updated_by")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([supplierId])
  @@index([isDefault])
  @@map("supplier_bank_accounts")
}

// ==================== 供应商报价表 ====================

model SupplierQuotation {
  id                String         @id @default(cuid())

  // 供应商信息
  supplierId        String         @map("supplier_id")
  supplier          Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // 产品信息
  productId         String?        @map("product_id") // 产品ID（可关联Product表）
  productCode       String?        @map("product_code") // 产品编码
  productName       String         @map("product_name") // 产品名称
  productSpec       String?        @map("product_spec") // 产品规格

  // 报价信息
  quotationNo       String         @unique @map("quotation_no") // 报价单号
  quotationDate     DateTime       @map("quotation_date") // 报价日期
  validFrom         DateTime       @map("valid_from") // 有效期开始
  validTo           DateTime       @map("valid_to") // 有效期结束

  // 价格信息
  currency          String         @default("CNY") // 币种
  unitPrice         Decimal        @db.Decimal(15, 4) @map("unit_price") // 单价
  unit              String         @default("PCS") // 单位
  moq               Int?           @map("moq") // 最小起订量（Minimum Order Quantity）
  leadTime          Int?           @map("lead_time") // 交货周期（天）

  // 税率与付款
  taxRate           Decimal?       @db.Decimal(5, 2) @map("tax_rate") // 税率
  paymentTerms      String?        @map("payment_terms") // 付款条款

  // 状态
  status            ApprovalStatus @default(PENDING) // 审核状态
  isActive          Boolean        @default(true) @map("is_active") // 是否有效

  // 备注
  remark            String?
  attachments       Json?          // 附件

  // 时间戳
  createdBy         String?        @map("created_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedBy         String?        @map("updated_by")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  @@index([supplierId])
  @@index([quotationNo])
  @@index([quotationDate])
  @@index([status])
  @@index([validFrom, validTo])
  @@map("supplier_quotations")
}

// ==================== 客户相关枚举 ====================

enum CustomerStage {
  POTENTIAL  // 潜在客户
  FORMAL     // 正式客户
  RETIRED    // 退休客户
}

enum ShippingMethod {
  SEA        // 海运
  LAND       // 陆运
  AIR        // 空运
  SUPPLIER   // 供应商送货
}

enum PaymentMethod {
  TT         // 电汇
  LC         // 信用证
  DP         // 付款交单
  DA         // 承兑交单
  OA         // 赊账
  CASH       // 现金
  OTHER      // 其他
}

// ==================== 客户主表 ====================

model Customer {
  id                    String          @id @default(cuid())

  // 基本信息
  code                  String          @unique // 客户编号
  name                  String          // 企业名称
  shortName             String?         @map("short_name") // 简称
  countryCode           String?         @map("country_code") // 国家编码
  website               String?         // 官网
  email                 String?         // 电子邮件

  // 客户阶段与分类
  stage                 CustomerStage   @default(POTENTIAL) // 客户阶段（潜在客户，正式客户，退休客户）
  isForeign             Boolean         @default(false) @map("is_foreign") // 国外客户标志
  isAgent               Boolean         @default(false) @map("is_agent") // 是否是代理

  // 业务信息
  shippingMethod        ShippingMethod? @map("shipping_method") // 运输方式(海运、陆运、空运、供应商送货)
  paymentMethodId       String?         @map("payment_method_id") // 收款方式id
  currency              String?         @default("CNY") // 币种
  salesRepList          Json?           @map("sales_rep_list") // 业务员列表（JSON数组）
  salesRep              String?         @map("sales_rep") // 主业务员

  // 地址信息
  businessAddress       String?         @map("business_address") // 营业地址
  mailingAddress        String?         @map("mailing_address") // 寄件地址
  phone                 String?         // 联系电话

  // 展会信息
  exhibitionSeriesId    String?         @map("exhibition_series_id") // 展会系列id
  exhibitionId          String?         @map("exhibition_id") // 展会id

  // 唛头信息
  frontMark             String?         @map("front_mark") // 正面唛头
  sideMark              String?         @map("side_mark") // 侧面唛头

  // 收货人/通知人
  consignee             String?         // 收货人
  notifyParty           String?         @map("notify_party") // 通知人

  // 财务信息
  enableCreditLimit     Boolean         @default(false) @map("enable_credit_limit") // 启用信用额度
  creditLimit           Decimal?        @db.Decimal(15, 2) @map("credit_limit") // 信用额度
  isSinosure            Boolean         @default(false) @map("is_sinosure") // 是否是中信保
  paymentType           String?         @map("payment_type") // 收款类型
  invoiceTitle          String?         @map("invoice_title") // 开票抬头
  taxRate               Decimal?        @db.Decimal(5, 2) @map("tax_rate") // 税率

  // 客户来源
  customerSource        String?         @map("customer_source") // 客户来源

  // 状态管理
  approvalStatus        ApprovalStatus  @default(PENDING) @map("approval_status") // 审核状态
  isFormal              Boolean         @default(false) @map("is_formal") // 转正标识
  formalTime            DateTime?       @map("formal_time") // 转正时间
  isEnabled             Boolean         @default(true) @map("is_enabled") // 是否启用

  // 变更管理
  isChanged             Boolean         @default(false) @map("is_changed") // 是否变更
  changeStatus          ChangeStatus?   @map("change_status") // 变更状态
  changeDeleted         Boolean         @default(false) @map("change_deleted") // 变更是否删除
  version               Int             @default(1) // 版本号
  impactScope           String?         @map("impact_scope") // 影响范围
  processModelId        String?         @map("process_model_id") // 流程模型标识

  // 内部标识
  isInternalEnterprise  Boolean         @default(false) @map("is_internal_enterprise") // 内部企业标识 0-否 1-是
  internalEnterprisePk  String?         @map("internal_enterprise_pk") // 内部企业主键

  // 关联客户
  relatedCustomerCode   String?         @map("related_customer_code") // 关联客户编号

  // 附件与备注
  attachments           Json?           // 附件（JSON数组）
  images                Json?           // 图片（JSON数组）
  remark                String?         // 备注信息

  // 时间戳
  createdBy             String?         @map("created_by")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedBy             String?         @map("updated_by")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")

  // 关联关系
  bankAccounts          CustomerBankAccount[]
  contacts              CustomerContact[]

  @@index([code])
  @@index([stage])
  @@index([approvalStatus])
  @@index([isForeign])
  @@index([isAgent])
  @@map("customers")
}

// ==================== 客户银行账户信息表 ====================

model CustomerBankAccount {
  id              String    @id @default(cuid())

  customerId      String    @map("customer_id")
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  customerVersion Int       @default(1) @map("customer_version") // 客户版本
  bankName        String    @map("bank_name") // 开户行
  bankAccount     String?   @map("bank_account") // 银行账户
  accountNumber   String    @map("account_number") // 银行账号
  branchAddress   String?   @map("branch_address") // 开户行地址
  branchContact   String?   @map("branch_contact") // 开户行联系人
  isDefault       Boolean   @default(false) @map("is_default") // 是否默认账户 0-否，1-是

  version         Int       @default(1) // 版本

  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedBy       String?   @map("updated_by")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([customerId])
  @@index([isDefault])
  @@map("customer_bank_accounts")
}

// ==================== 客户联系人表 ====================

model CustomerContact {
  id              String    @id @default(cuid())

  customerId      String    @map("customer_id")
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  customerVersion Int       @default(1) @map("customer_version") // 客户版本
  name            String    // 联系人姓名
  position        String?   // 联系人职位
  email           String?   // 电子邮件
  mobile          String?   // 手机
  phone           String?   // 座机
  address         String?   // 住宅地址
  wechat          String?   // 微信
  qq              String?   // QQ
  businessCard    String?   @map("business_card") // 名片
  isDefault       Boolean   @default(false) @map("is_default") // 默认联系人
  remark          String?   // 备注

  version         Int       @default(1) // 版本

  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedBy       String?   @map("updated_by")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([customerId])
  @@index([isDefault])
  @@map("customer_contacts")
}

// ==================== 销售合同相关枚举 ====================

enum SalesContractStatus {
  DRAFT         // 草稿
  PENDING       // 待审核
  APPROVED      // 已审核
  IN_PROGRESS   // 执行中
  COMPLETED     // 已完成
  CANCELLED     // 已取消
}

enum SalesContractType {
  STANDARD      // 标准合同
  SAMPLE        // 样品合同
  TRIAL         // 试单
  REPEAT        // 返单
}

enum PrintStatus {
  NOT_PRINTED   // 未打印
  PRINTED       // 已打印
}

enum SignBackStatus {
  NOT_SIGNED    // 未回签
  SIGNED        // 已回签
  PARTIAL       // 部分回签
}

enum ConfirmStatus {
  NOT_CONFIRMED // 未确认
  CONFIRMED     // 已确认
  REJECTED      // 已拒绝
}

// ==================== 销售合同主表 ====================

model SalesContract {
  id                        String              @id @default(cuid())

  // 基本信息
  code                      String              @unique // 编号
  internalCode              String?             @unique @map("internal_code") // 内部生成编号
  customerPoNo              String?             @map("customer_po_no") // 客户PO号
  orderLinkCode             String?             @map("order_link_code") // 订单链路编号
  orderPath                 String?             @map("order_path") // 订单路径

  // 客户信息
  customerId                String              @map("customer_id") // 客户编号
  customerCode              String              @map("customer_code") // 客户编号（冗余）
  customerName              String?             @map("customer_name") // 客户名称（冗余）
  receivableCustomerCode    String?             @map("receivable_customer_code") // 应收客户编号
  deliveryCustomerCode      String?             @map("delivery_customer_code") // 收货客户编号
  deliveryAddress           String?             @map("delivery_address") // 送货地址

  // 内部客户信息
  internalCustomerPk        String?             @map("internal_customer_pk") // 内部客户主键
  internalCustomerCode      String?             @map("internal_customer_code") // 内部客户编号
  internalCustomerName      String?             @map("internal_customer_name") // 内部客户名称
  internalLegalEntity       String?             @map("internal_legal_entity") // 内部法人单位名称

  // 人员信息
  salesPerson               String?             @map("sales_person") // 销售人员
  merchandiser              String?             @map("merchandiser") // 跟单员
  buyer                     String?             // 采购员

  // 金额与汇率
  currency                  String              @default("USD") // 交易币别
  usdRate                   Decimal?            @db.Decimal(10, 6) @map("usd_rate") // 美元汇率
  creationRate              Decimal?            @db.Decimal(10, 6) @map("creation_rate") // 创建时汇率
  totalAmount               Decimal             @default(0) @db.Decimal(15, 2) @map("total_amount") // 销售总金额
  totalAmountUsd            Decimal             @default(0) @db.Decimal(15, 2) @map("total_amount_usd") // 销售总金额USD
  originalCurrencyAmount    Decimal?            @db.Decimal(15, 2) @map("original_currency_amount") // 原币种金额

  // 收款信息
  paymentAccountId          String?             @map("payment_account_id") // 收款账号id
  paymentAccountCode        String?             @map("payment_account_code") // 收款账号
  paymentMethodName         String?             @map("payment_method_name") // 收款方式名称
  receivedAmount            Decimal?            @default(0) @db.Decimal(15, 2) @map("received_amount") // 收款合计
  receivableRemittance      Decimal?            @db.Decimal(15, 2) @map("receivable_remittance") // 应收汇款

  // 客户国家与区域
  customerCountryName       String?             @map("customer_country_name") // 客户国别名称
  customerRegionName        String?             @map("customer_region_name") // 客户区域名称
  tradeCountryName          String?             @map("trade_country_name") // 贸易国别名称
  tradeCountryRegion        String?             @map("trade_country_region") // 贸易国别区域

  // 物流信息
  priceTerms                String?             @map("price_terms") // 价格条款（FOB/CIF/CNF等）
  shippingCountryName       String?             @map("shipping_country_name") // 出运国名称
  shippingCountryRegion     String?             @map("shipping_country_region") // 出运国区域
  departurePortName         String?             @map("departure_port_name") // 出运口岸名称
  destinationPortName       String?             @map("destination_port_name") // 目的口岸名称
  transportMethod           String?             @map("transport_method") // 运输方式
  customerDeliveryDate      DateTime?           @map("customer_delivery_date") // 客户交期

  // 柜型信息
  container20ft             Int?                @default(0) @map("container_20ft") // 20尺柜
  container40ft             Int?                @default(0) @map("container_40ft") // 40尺柜
  container40hq             Int?                @default(0) @map("container_40hq") // 40尺高柜
  bulkCargo                 Decimal?            @db.Decimal(10, 2) @map("bulk_cargo") // 散货

  // 费用信息
  containerFee              Decimal?            @default(0) @db.Decimal(15, 2) @map("container_fee") // 拖柜费
  estimatedFreight          Decimal?            @default(0) @db.Decimal(15, 2) @map("estimated_freight") // 预估总运费
  commission                Decimal?            @default(0) @db.Decimal(15, 2) // 佣金
  platformFee               Decimal?            @default(0) @db.Decimal(15, 2) @map("platform_fee") // 平台费
  insuranceFee              Decimal?            @default(0) @db.Decimal(15, 2) @map("insurance_fee") // 保险费
  sinosureFee               Decimal?            @default(0) @db.Decimal(15, 2) @map("sinosure_fee") // 中信保费用
  lumpSumFee                Decimal?            @default(0) @db.Decimal(15, 2) @map("lump_sum_fee") // 包干费
  additionalAmount          Decimal?            @default(0) @db.Decimal(15, 2) @map("additional_amount") // 加项金额
  deductionAmount           Decimal?            @default(0) @db.Decimal(15, 2) @map("deduction_amount") // 减项金额
  inspectionFee             Decimal?            @default(0) @db.Decimal(15, 2) @map("inspection_fee") // 验货费用

  // 统计信息
  totalBoxes                Int?                @default(0) @map("total_boxes") // 箱数合计
  totalGrossWeight          Decimal?            @default(0) @db.Decimal(10, 3) @map("total_gross_weight") // 毛重合计
  totalNetWeight            Decimal?            @default(0) @db.Decimal(10, 3) @map("total_net_weight") // 净重合计
  totalVolume               Decimal?            @default(0) @db.Decimal(10, 3) @map("total_volume") // 体积合计
  totalValue                Decimal?            @default(0) @db.Decimal(15, 2) @map("total_value") // 货值合计
  totalQuantity             Decimal?            @default(0) @db.Decimal(10, 2) @map("total_quantity") // 数量合计

  // 成本与利润
  inventoryCostTotal        Decimal?            @default(0) @db.Decimal(15, 2) @map("inventory_cost_total") // 库存成本合计
  purchaseTotal             Decimal?            @default(0) @db.Decimal(15, 2) @map("purchase_total") // 采购总金额
  accessoryPurchaseTotal    Decimal?            @default(0) @db.Decimal(15, 2) @map("accessory_purchase_total") // 配件采购合计
  estimatedPackagingTotal   Decimal?            @default(0) @db.Decimal(15, 2) @map("estimated_packaging_total") // 预计包材合计
  taxRefundTotal            Decimal?            @default(0) @db.Decimal(15, 2) @map("tax_refund_total") // 退税合计
  orderGrossProfit          Decimal?            @default(0) @db.Decimal(15, 2) @map("order_gross_profit") // 订单毛利
  grossProfitMargin         Decimal?            @db.Decimal(5, 2) @map("gross_profit_margin") // 毛利率

  // 来源与关联
  sourceContractCode        String?             @map("source_contract_code") // 来源销售合同编号
  sourceContractId          String?             @map("source_contract_id") // 来源销售合同id
  sourceCode                String?             @map("source_code") // 来源编号

  // 状态字段
  status                    SalesContractStatus @default(DRAFT) // 状态
  contractType              SalesContractType   @default(STANDARD) @map("contract_type") // 销售合同类型
  approvalStatus            ApprovalStatus      @default(PENDING) @map("approval_status") // 审核状态
  confirmStatus             ConfirmStatus       @default(NOT_CONFIRMED) @map("confirm_status") // 确认状态
  changeStatus              ChangeStatus?       @map("change_status") // 变更状态

  // 打印与回签
  printStatus               PrintStatus         @default(NOT_PRINTED) @map("print_status") // 打印状态
  printCount                Int                 @default(0) @map("print_count") // 打印次数
  signBackStatus            SignBackStatus      @default(NOT_SIGNED) @map("sign_back_status") // 回签标记
  signBackDate              DateTime?           @map("sign_back_date") // 回签日期
  signBackPerson            String?             @map("sign_back_person") // 回签人
  signBackDescription       String?             @map("sign_back_description") // 回签描述
  signBackAttachments       Json?               @map("sign_back_attachments") // 回签附件（JSON数组）

  // 标识字段
  isAgent                   Boolean             @default(false) @map("is_agent") // 是否代理
  isBookingSpace            Boolean             @default(false) @map("is_booking_space") // 是否订舱
  autoCreated               Boolean             @default(false) @map("auto_created") // 自动生成标识 0-否 1-是
  syncFlag                  String?             @map("sync_flag") // 同步标记

  // 转下游标记
  toPurchasePlan            Boolean             @default(false) @map("to_purchase_plan") // 转采购计划标记
  toPurchasePlanTime        DateTime?           @map("to_purchase_plan_time") // 转采购计划时间

  // 附件与备注
  attachments               Json?               // 附件（JSON数组）
  designDraft               String?             @map("design_draft") // 设计稿
  remark                    String?             // 备注
  entryDate                 DateTime?           @map("entry_date") // 录入日期

  // 流程
  processInstanceId         String?             @map("process_instance_id") // 流程实例的编号

  // 变更管理
  isChanged                 Boolean             @default(false) @map("is_changed")
  changeDeleted             Boolean             @default(false) @map("change_deleted")
  version                   Int                 @default(1)
  impactScope               String?             @map("impact_scope")
  processModelId            String?             @map("process_model_id")

  // 时间戳
  createdBy                 String?             @map("created_by")
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedBy                 String?             @map("updated_by")
  updatedAt                 DateTime            @updatedAt @map("updated_at")
  deletedAt                 DateTime?           @map("deleted_at")

  // 关联关系
  items                     SalesContractItem[] @relation("SalesContractItems")

  @@index([code])
  @@index([customerId])
  @@index([status])
  @@index([approvalStatus])
  @@index([contractType])
  @@index([createdAt])
  @@map("sales_contracts")
}

// ==================== 销售合同明细表 ====================

model SalesContractItem {
  id                    String         @id @default(cuid())

  // 关联销售合同
  salesContractId       String         @map("sales_contract_id")
  salesContract         SalesContract  @relation("SalesContractItems", fields: [salesContractId], references: [id], onDelete: Cascade)

  // 行号
  lineNumber            Int            @map("line_number") // 行号

  // 产品信息
  productId             String?        @map("product_id") // 产品ID
  productCode           String?        @map("product_code") // 产品编码
  productName           String         @map("product_name") // 产品名称
  productSpec           String?        @map("product_spec") // 产品规格
  customerProductNo     String?        @map("customer_product_no") // 客户产品编号

  // 数量与单位
  quantity              Decimal        @db.Decimal(10, 2) // 数量
  unit                  String         @default("PCS") // 单位

  // 价格信息
  unitPrice             Decimal        @db.Decimal(15, 4) @map("unit_price") // 单价
  currency              String         @default("USD") // 币种
  amount                Decimal        @db.Decimal(15, 2) // 金额

  // 包装信息
  boxes                 Int?           @default(0) // 箱数
  grossWeight           Decimal?       @db.Decimal(10, 3) @map("gross_weight") // 毛重
  netWeight             Decimal?       @db.Decimal(10, 3) @map("net_weight") // 净重
  volume                Decimal?       @db.Decimal(10, 3) // 体积
  packageMethod         String?        @map("package_method") // 包装方式

  // 成本信息
  purchasePrice         Decimal?       @db.Decimal(15, 4) @map("purchase_price") // 采购价
  costPrice             Decimal?       @db.Decimal(15, 4) @map("cost_price") // 成本价
  taxRefund             Decimal?       @db.Decimal(15, 2) @map("tax_refund") // 退税

  // 交期与备注
  deliveryDate          DateTime?      @map("delivery_date") // 交期
  remark                String?        // 备注

  // 来源追溯
  sourceContractId      String?        @map("source_contract_id") // 来源合同ID
  sourceItemId          String?        @map("source_item_id") // 来源明细ID
  sourceLineNumber      Int?           @map("source_line_number") // 来源行号

  // 时间戳
  createdBy             String?        @map("created_by")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedBy             String?        @map("updated_by")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  deletedAt             DateTime?      @map("deleted_at")

  @@index([salesContractId])
  @@index([productId])
  @@index([lineNumber])
  @@map("sales_contract_items")
}

// ==================== 采购计划相关枚举 ====================

enum PurchasePlanStatus {
  DRAFT         // 草稿
  PENDING       // 待审核
  APPROVED      // 已审核
  IN_PROGRESS   // 执行中
  COMPLETED     // 已完成
  CLOSED        // 已结案
  CANCELLED     // 已取消
}

enum SourceType {
  SALES_CONTRACT    // 销售合同
  PURCHASE_PLAN     // 采购计划
  OTHER            // 其他
}

enum SalesType {
  DOMESTIC     // 内销
  EXPORT       // 外销
  OTHER        // 其他
}

enum PurchaseType {
  NORMAL           // 正常采购
  URGENT           // 紧急采购
  REPLENISHMENT    // 补单
}

enum PurchaseMode {
  ORDER        // 订单采购
  INVENTORY    // 库存采购
  CONSIGNMENT  // 寄售
}

// ==================== 采购计划主表 ====================

model PurchasePlan {
  id                    String              @id @default(cuid())

  // 基本信息
  code                  String              @unique // 计划编号
  planDate              DateTime            @map("plan_date") // 计划日期
  expectedDeliveryDate  DateTime            @map("expected_delivery_date") // 预计交期
  planStatus            PurchasePlanStatus  @default(DRAFT) @map("plan_status") // 计划状态
  approvalStatus        ApprovalStatus      @default(PENDING) @map("approval_status") // 审核状态

  // 来源信息
  sourceType            SourceType?         @map("source_type") // 来源单类型
  salesContractId       String?             @map("sales_contract_id") // 销售合同主键
  salesContractCode     String?             @map("sales_contract_code") // 销售合同编号
  sourcePlanCode        String?             @map("source_plan_code") // 来源计划编号
  orderLinkCode         String?             @map("order_link_code") // 订单链路编号
  orderPath             String?             @map("order_path") // 订单路径

  // 客户信息
  customerId            String?             @map("customer_id") // 客户ID
  customerCode          String?             @map("customer_code") // 客户编号

  // 采购主体与人员
  purchasingEntity      String?             @map("purchasing_entity") // 采购主体
  buyer                 String?             // 采购员
  salesPerson           String?             @map("sales_person") // 业务员
  salesRep              String?             @map("sales_rep") // 销售人员
  merchandiser          String?             // 跟单员

  // 辅料采购相关
  isAccessoryPurchase   Boolean             @default(false) @map("is_accessory_purchase") // 是否辅料采购
  accessoryBuyer        String?             @map("accessory_buyer") // 辅料采购员
  accessorySalesPerson  String?             @map("accessory_sales_person") // 辅料销售员
  accessoryMerchandiser String?             @map("accessory_merchandiser") // 辅料跟单员

  // 其他信息
  salesType             SalesType?          @map("sales_type") // 销售类型
  splitFlag             Boolean             @default(false) @map("split_flag") // 拆分标识
  creatorDepartment     String?             @map("creator_department") // 创建人部门

  // 时间信息
  closedTime            DateTime?           @map("closed_time") // 结案时间
  completedTime         DateTime?           @map("completed_time") // 完成时间

  // 备注与附件
  remark                String?             // 备注
  attachments           Json?               // 附件（JSON数组）

  // 变更管理
  isChanged             Boolean             @default(false) @map("is_changed")
  changeStatus          ChangeStatus?       @map("change_status")
  changeDeleted         Boolean             @default(false) @map("change_deleted")
  version               Int                 @default(1)
  impactScope           String?             @map("impact_scope")
  processModelId        String?             @map("process_model_id")

  // 时间戳
  createdBy             String?             @map("created_by")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedBy             String?             @map("updated_by")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  deletedAt             DateTime?           @map("deleted_at")

  // 关联关系
  items                 PurchasePlanItem[]  @relation("PurchasePlanItems")

  @@index([code])
  @@index([planStatus])
  @@index([approvalStatus])
  @@index([salesContractId])
  @@index([customerId])
  @@index([planDate])
  @@index([expectedDeliveryDate])
  @@map("purchase_plans")
}

// ==================== 采购计划明细表 ====================

model PurchasePlanItem {
  id                    String         @id @default(cuid())

  // 关联采购计划
  purchasePlanId        String         @map("purchase_plan_id")
  purchasePlan          PurchasePlan   @relation("PurchasePlanItems", fields: [purchasePlanId], references: [id], onDelete: Cascade)

  // 行号
  lineNumber            Int            @map("line_number") // 行号

  // 产品信息
  productId             String?        @map("product_id") // 产品ID
  productCode           String         @map("product_code") // SKU编号
  productName           String         @map("product_name") // 产品名称
  barcode               String?        // 条形码
  customerProductNo     String?        @map("customer_product_no") // 客户货号
  selfOwnedProductNo    String?        @map("self_owned_product_no") // 自营货号
  factoryProductNo      String?        @map("factory_product_no") // 工厂货号
  specification         String?        // 规格
  specificationDesc     String?        @map("specification_desc") // 规格描述

  // 数量信息
  salesQuantity         Decimal?       @db.Decimal(10, 2) @map("sales_quantity") // 销售数量
  contractQuantity      Decimal?       @db.Decimal(10, 2) @map("contract_quantity") // 合同数量
  purchaseQuantity      Decimal        @db.Decimal(10, 2) @map("purchase_quantity") // 采购数量
  pendingQuantity       Decimal?       @default(0) @db.Decimal(10, 2) @map("pending_quantity") // 待采购数量
  convertedQuantity     Decimal?       @default(0) @db.Decimal(10, 2) @map("converted_quantity") // 已转合同数量
  lockedInventory       Decimal?       @default(0) @db.Decimal(10, 2) @map("locked_inventory") // 锁定库存

  // 供应商信息
  supplierId            String?        @map("supplier_id") // 供应商ID
  supplierCode          String?        @map("supplier_code") // 供应商编号
  supplierName          String?        @map("supplier_name") // 供应商名称

  // 价格信息
  unitPrice             Decimal        @db.Decimal(15, 4) @map("unit_price") // 采购单价
  totalAmount           Decimal?       @db.Decimal(15, 2) @map("total_amount") // 总价
  taxRate               Decimal?       @default(0) @db.Decimal(5, 2) @map("tax_rate") // 税率
  includeTax            Boolean        @default(false) @map("include_tax") // 是否含税
  totalAmountWithTax    Decimal?       @db.Decimal(15, 2) @map("total_amount_with_tax") // 含税总价
  currency              String         @default("CNY") // 币种
  packagePrice          Decimal?       @db.Decimal(10, 2) @map("package_price") // 包装价

  // 采购信息
  deliveryDate          DateTime?      @map("delivery_date") // 交货日期
  purchaseType          PurchaseType?  @map("purchase_type") // 采购类型
  packageMethod         String?        @map("package_method") // 包装方式
  includeShipping       Boolean        @default(false) @map("include_shipping") // 是否含运费
  includePackage        Boolean        @default(false) @map("include_package") // 是否含包装
  moq                   Int?           @map("moq") // 最小起购量
  boxQuantity           Int?           @map("box_quantity") // 箱数

  // 标识字段
  isCommonAccessory     Boolean        @default(false) @map("is_common_accessory") // 是否通用辅料
  isSelfBrand           Boolean        @default(false) @map("is_self_brand") // 是否自主品牌
  isGift                Boolean        @default(false) @map("is_gift") // 是否赠品

  // 其他信息
  purchaseMode          PurchaseMode?  @map("purchase_mode") // 采购模式
  purchaseLink          String?        @map("purchase_link") // 采购链接
  thumbnail             String?        // 缩略图
  images                Json?          // 图片（JSON数组）
  remark                String?        // 备注
  attachments           Json?          // 附件（JSON数组）

  // 来源追溯
  salesContractId       String?        @map("sales_contract_id") // 来源销售合同ID
  salesContractItemId   String?        @map("sales_contract_item_id") // 来源销售合同明细ID
  sourcePlanItemId      String?        @map("source_plan_item_id") // 来源计划明细ID

  // 转采购合同标记
  convertedToPurchase   Boolean        @default(false) @map("converted_to_purchase") // 转采购合同标记
  convertedTime         DateTime?      @map("converted_time") // 转采购合同时间
  purchaseContractCode  String?        @map("purchase_contract_code") // 采购合同编号

  // 时间戳
  createdBy             String?        @map("created_by")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedBy             String?        @map("updated_by")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  deletedAt             DateTime?      @map("deleted_at")

  @@index([purchasePlanId])
  @@index([productId])
  @@index([supplierId])
  @@index([lineNumber])
  @@index([salesContractId])
  @@map("purchase_plan_items")
}

// ==================== 审核规则配置表 ====================

model ApprovalRuleConfig {
  id          String   @id @default(cuid())
  code        String   @unique              // 规则标识（如 "sales_contract_approval"）
  name        String                        // 规则名称
  docType     String   @map("doc_type")     // 适用的单据类型（如 "sales_contract"）
  levels      Json                          // 审核级别定义 JSON（ApprovalLevel[]）
  condition   Json?                         // 触发条件（JSON 配置，服务端解释执行）
  enabled     Boolean  @default(true)

  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  instances   ApprovalInstance[]

  @@index([docType])
  @@index([enabled])
  @@map("approval_rule_configs")
}

// ==================== 审核实例表 ====================

model ApprovalInstance {
  id                    String    @id @default(cuid())

  ruleId                String    @map("rule_id")
  rule                  ApprovalRuleConfig @relation(fields: [ruleId], references: [id])

  docType               String    @map("doc_type")      // 单据类型
  docId                 String    @map("doc_id")         // 单据 ID
  docNumber             String?   @map("doc_number")     // 单据编号（冗余）

  status                String    @default("in_progress") // pending | in_progress | approved | rejected
  currentLevel          Int       @default(1) @map("current_level")
  currentLevelApprovers Json      @default("[]") @map("current_level_approvers")

  submitterId           String    @map("submitter_id")
  submitterName         String?   @map("submitter_name")
  submittedAt           DateTime  @default(now()) @map("submitted_at")
  completedAt           DateTime? @map("completed_at")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  records               ApprovalRecord[]

  @@index([docType, docId])
  @@index([status])
  @@index([submitterId])
  @@map("approval_instances")
}

// ==================== 审核记录表 ====================

model ApprovalRecord {
  id            String   @id @default(cuid())

  instanceId    String   @map("instance_id")
  instance      ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  level         Int                          // 审核级别（0=提交, 1+=审批级别）
  action        String                       // submit | approve | reject | withdraw
  userId        String   @map("user_id")
  userName      String   @map("user_name")
  comment       String?                      // 审批意见

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([instanceId])
  @@index([userId])
  @@map("approval_records")
}

// ==================== 系统管理：菜单表 ====================

model SysMenu {
  id          String    @id @default(cuid())
  title       String                        // 菜单标题
  icon        String?                       // 图标名称（lucide-react 图标名）
  path        String?                       // 路由路径
  parentId    String?   @map("parent_id")   // 父菜单ID，null表示顶级菜单
  parent      SysMenu?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    SysMenu[] @relation("MenuTree")
  orderNum    Int       @default(0) @map("order_num") // 排序顺序
  menuType    String    @default("menu") @map("menu_type") // 类型：menu | button
  permission  String?                       // 权限标识
  status      String    @default("visible") // 状态：visible | hidden

  // 角色关联
  roleMenus   SysRoleMenu[]

  // 时间戳
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedBy   String?   @map("updated_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([parentId])
  @@index([orderNum])
  @@index([status])
  @@map("sys_menus")
}

// ==================== 系统管理：角色表 ====================

model SysRole {
  id          String    @id @default(cuid())
  code        String    @unique             // 角色编码
  name        String                        // 角色名称
  description String?                       // 描述
  status      String    @default("active")  // 状态：active | inactive

  // 关联关系
  userRoles       SysUserRole[]
  roleMenus       SysRoleMenu[]
  dataPermissions SysDataPermission[]

  // 时间戳
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedBy   String?   @map("updated_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([code])
  @@index([status])
  @@map("sys_roles")
}

// ==================== 系统管理：数据权限表 ====================

model SysDataPermission {
  id                 String    @id @default(cuid())
  roleId             String    @map("role_id")
  role               SysRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  typeId             String    @map("type_id")           // 单据类型ID，"*" 表示全部类型
  level              String    @default("personal")      // "all" | "department" | "personal"
  extraDepartmentIds Json?     @map("extra_department_ids") // 特殊授权的部门ID列表 ["id1","id2"]
  extraUserIds       Json?     @map("extra_user_ids")       // 特殊授权的用户ID列表 ["id1","id2"]

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([roleId, typeId])
  @@index([roleId])
  @@index([typeId])
  @@map("sys_data_permissions")
}

// ==================== 系统管理：用户表 ====================

model SysUser {
  id            String    @id @default(cuid())
  username      String    @unique             // 用户名（登录名）
  password      String                        // 密码（bcrypt 哈希）
  name          String                        // 姓名
  email         String?                       // 邮箱
  phone         String?                       // 电话
  department    String?                       // 部门（旧字段，兼容保留）
  departmentId  String?   @map("department_id") // 部门ID（FK）
  dept          Department? @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  status        String    @default("active")  // 状态：active | inactive

  // 关联关系
  userRoles   SysUserRole[]

  // 时间戳
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedBy   String?   @map("updated_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([username])
  @@index([status])
  @@index([departmentId])
  @@map("sys_users")
}

// ==================== 系统管理：用户-角色关联表 ====================

model SysUserRole {
  id      String  @id @default(cuid())

  userId  String  @map("user_id")
  user    SysUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId  String  @map("role_id")
  role    SysRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("sys_user_roles")
}

// ==================== 系统管理：角色-菜单关联表 ====================

model SysRoleMenu {
  id      String  @id @default(cuid())

  roleId  String  @map("role_id")
  role    SysRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  menuId  String  @map("menu_id")
  menu    SysMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roleId, menuId])
  @@index([roleId])
  @@index([menuId])
  @@map("sys_role_menus")
}

// ==================== 文档级权限表 ====================

model DocumentPermission {
  id         String   @id @default(cuid())
  docType    String   @map("doc_type")        // 单据类型（如 "sales_contract"）
  docId      String   @map("doc_id")          // 单据 ID
  userId     String   @map("user_id")         // 被授权用户 ID
  userName   String   @map("user_name")       // 用户姓名（冗余，方便展示）
  permission String   @default("read")        // "read" | "write"
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([docType, docId, userId])
  @@index([docType, docId])
  @@index([userId])
  @@map("document_permissions")
}
