  paymentMethodId   String? @map("payment_method_id") // 收款方式主键
  paymentMethodName String? @map("payment_method_name") // 收款方式名称

  // 价格条款与交期
  priceTerms           String?   @map("price_terms") // 价格条款
  customerDeliveryDate DateTime? @map("customer_delivery_date") // 客户交期

  // 报关信息
  hsCode          String?  @map("hs_code") // HS编码
  inspectionType  String?  @map("inspection_type") // 商检类型
  taxRefundRate   Decimal? @map("tax_refund_rate") @db.Decimal(5, 2) // 退税率
  taxRefundAmount Decimal? @map("tax_refund_amount") @db.Decimal(15, 2) // 退税金额

  // 包装信息
  packageMethod       String?  @map("package_method") // 包装方式
  outerBoxQuantity    Int?     @map("outer_box_quantity") // 外箱装量
  innerBoxQuantity    Int?     @map("inner_box_quantity") // 内盒装量
  boxCount            Int?     @map("box_count") // 箱数
  outerBoxUnit        String?  @map("outer_box_unit") // 外箱单位
  outerBoxLength      Decimal? @map("outer_box_length") @db.Decimal(10, 2) // 外箱长度
  outerBoxWidth       Decimal? @map("outer_box_width") @db.Decimal(10, 2) // 外箱宽度
  outerBoxHeight      Decimal? @map("outer_box_height") @db.Decimal(10, 2) // 外箱高度
  outerBoxVolume      Decimal? @map("outer_box_volume") @db.Decimal(10, 4) // 外箱体积
  totalVolume         Decimal? @map("total_volume") @db.Decimal(10, 4) // 总体积
  outerBoxNetWeight   Decimal? @map("outer_box_net_weight") @db.Decimal(10, 3) // 外箱净重
  totalNetWeight      Decimal? @map("total_net_weight") @db.Decimal(10, 3) // 总净重
  outerBoxGrossWeight Decimal? @map("outer_box_gross_weight") @db.Decimal(10, 3) // 外箱毛重
  totalGrossWeight    Decimal? @map("total_gross_weight") @db.Decimal(10, 3) // 总毛重

  // 费用信息
  freight            Decimal? @db.Decimal(15, 2) // 运费
  packagePrice       Decimal? @map("package_price") @db.Decimal(15, 4) // 包装价
  totalAmount        Decimal? @map("total_amount") @db.Decimal(15, 2) // 总价
  totalAmountWithTax Decimal? @map("total_amount_with_tax") @db.Decimal(15, 2) // 含税总价
  commissionAmount   Decimal? @map("commission_amount") @db.Decimal(15, 2) // 佣金金额
  commissionType     String?  @map("commission_type") // 佣金类型
  commissionRate     Decimal? @map("commission_rate") @db.Decimal(5, 2) // 佣金比例
  grossProfitMargin  Decimal? @map("gross_profit_margin") @db.Decimal(5, 2) // 毛利率

  // 下单主体
  orderEntityId   String? @map("order_entity_id") // 下单主体主键
  orderEntityName String? @map("order_entity_name") // 下单主体名称

  // 分箱与发货
  isSeparateBox    Boolean @default(false) @map("is_separate_box") // 是否分箱
  shippingLocation String? @map("shipping_location") // 发货地点
  isIncludeGift    Boolean @default(false) @map("is_include_gift") // 是否包含赠品

  // 仓库信息
  warehouseCode String? @map("warehouse_code") // 仓库编号
  warehouseName String? @map("warehouse_name") // 仓库名称

  // 来源追溯
  sourceCode      String? @map("source_code") // 来源编号
  uniqueCode      String? @map("unique_code") // 唯一编号
  shippingOrderId String? @map("shipping_order_id") // 出运单主键

  // 转出运标记
  isConvertedToShipping Boolean @default(false) @map("is_converted_to_shipping") // 是否转出运明细
  status                String? @default("DRAFT") // 状态

  // 备注
  remark String? // 备注

  // 时间戳
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([shippingPlanId])
  @@index([productId])
  @@index([supplierId])
  @@index([customerId])
  @@index([salesContractCode])
  @@map("shipping_plan_items")
}

// ============================================================
// 出运单 (Shipping Order)
// ============================================================

enum ShippingOrderStatus {
  DRAFT // 草稿
  PENDING // 待审核
  APPROVED // 已审核
  IN_PROGRESS // 执行中
  COMPLETED // 已完成
  CANCELLED // 已取消
}

// ==================== 出运单主表 ====================

model ShippingOrder {
  id String @id @default(cuid())

  // 基本信息
  code         String              @unique // 编号
  planCode     String?             @map("plan_code") // 计划编号
  internalCode String?             @map("internal_code") // 内部生成编号
  status       ShippingOrderStatus @default(DRAFT) // 单据状态
  entryDate    DateTime?           @map("entry_date") // 录入日期
  invoiceDate  DateTime?           @map("invoice_date") // 发票日期

  // 来源信息
  sourceDetailId  String? @map("source_detail_id") // 来源明细id
  sourceCode      String? @map("source_code") // 来源编号
  orderLinkCode   String? @map("order_link_code") // 订单链路编号
  isBatchShipping Boolean @default(false) @map("is_batch_shipping") // 是否分批出运

  // 唛头信息
  frontMark String? @map("front_mark") // 正面唛头
  sideMark  String? @map("side_mark") // 侧面唛头

  // 收货人/通知人
  consignee   String? // 收货人
  notifyParty String? @map("notify_party") // 通知人

  // 客户信息
  customerId           String?   @map("customer_id") // 客户主键
  customerCode         String?   @map("customer_code") // 客户编号
  customerName         String?   @map("customer_name") // 客户名称
  customerContract     String?   @map("customer_contract") // 客户合同
  customerDeliveryDate DateTime? @map("customer_delivery_date") // 客户交期

  // 日期信息
  expectedShippingDate DateTime? @map("expected_shipping_date") // 预计出运
  shippingDate         DateTime? @map("shipping_date") // 出运日期
  warehouseEntryDate   DateTime? @map("warehouse_entry_date") // 进仓日期

  // 人员信息
  salesPerson    String? @map("sales_person") // 业务员
  buyer          String? // 采购员
  documentClerk  String? @map("document_clerk") // 单证员
  documentPerson String? @map("document_person") // 单据员
  entryPerson    String? @map("entry_person") // 录入人

  // 发票与价格
  invoiceNo  String? @map("invoice_no") // 发票号
  priceTerms String? @map("price_terms") // 价格条款

  // 运输方式
  transportMethod String? @map("transport_method") // 运输方式
  tradeMethod     String? @map("trade_method") // 贸易方式

  // 出运国信息
  shippingCountryId     String? @map("shipping_country_id") // 出运国主键
  shippingCountryName   String? @map("shipping_country_name") // 出运国名称
  shippingCountryRegion String? @map("shipping_country_region") // 出运国区域

  // 出运口岸信息
  departurePortId   String? @map("departure_port_id") // 出运口岸主键
  departurePortName String? @map("departure_port_name") // 出运口岸名称

  // 贸易国别信息
  tradeCountryId     String? @map("trade_country_id") // 贸易国别主键
  tradeCountryName   String? @map("trade_country_name") // 贸易国别名称
  tradeCountryRegion String? @map("trade_country_region") // 贸易国别区域

  // 目的口岸信息
  destinationPortId   String? @map("destination_port_id") // 目的口岸主键
  destinationPortName String? @map("destination_port_name") // 目的口岸名称

  // 出仓信息
  isWarehouseOut   Boolean   @default(false) @map("is_warehouse_out") // 是否出仓
  warehouseOutDate DateTime? @map("warehouse_out_date") // 出仓日期
  isShipped        Boolean   @default(false) @map("is_shipped") // 是否出运

  // 报关信息
  customsStatus         String? @map("customs_status") // 报关状态
  isConvertedToExchange Boolean @default(false) @map("is_converted_to_exchange") // 转结汇单
  isConvertedToInvoice  Boolean @default(false) @map("is_converted_to_invoice") // 已转开票通知

  // 船运信息
  shippingAgentId          String?   @map("shipping_agent_id") // 船代公司主键
  shippingAgentName        String?   @map("shipping_agent_name") // 船代公司名称
  voyageNo                 String?   @map("voyage_no") // 船次
  billOfLadingNo           String?   @map("bill_of_lading_no") // 提单号
  expectedSettlementDate   DateTime? @map("expected_settlement_date") // 预计结单时间
  expectedCustomsClearDate DateTime? @map("expected_customs_clear_date") // 预计结关时间
  expectedPortArrivalDate  DateTime? @map("expected_port_arrival_date") // 预计结港时间

  // 外贸公司主体
  tradingCompanyId   String? @map("trading_company_id") // 外贸公司主体主键
  tradingCompanyName String? @map("trading_company_name") // 外贸公司主体名称

  // 柜型信息
  container20ft Int?     @default(0) @map("container_20ft") // 20尺柜
  container40ft Int?     @default(0) @map("container_40ft") // 40尺柜
  container40hq Int?     @default(0) @map("container_40hq") // 40尺高柜
  bulkCargo     Decimal? @map("bulk_cargo") @db.Decimal(10, 2) // 散货

  // 汇总统计
  totalQuantity    Decimal? @default(0) @map("total_quantity") @db.Decimal(10, 2) // 数量合计
  totalBoxes       Int?     @default(0) @map("total_boxes") // 箱数合计
  totalGrossWeight Decimal? @default(0) @map("total_gross_weight") @db.Decimal(10, 3) // 毛重合计
  totalNetWeight   Decimal? @default(0) @map("total_net_weight") @db.Decimal(10, 3) // 净重合计
  totalVolume      Decimal? @default(0) @map("total_volume") @db.Decimal(10, 3) // 体积合计

  // 金额统计
  customsTotalAmount Decimal? @default(0) @map("customs_total_amount") @db.Decimal(15, 2) // 报关合计
  totalValue         Decimal? @default(0) @map("total_value") @db.Decimal(15, 2) // 货值合计
  purchaseTotal      Decimal? @default(0) @map("purchase_total") @db.Decimal(15, 2) // 采购总金额
  taxRefundTotal     Decimal? @default(0) @map("tax_refund_total") @db.Decimal(15, 2) // 退税总额
  commissionAmount   Decimal? @default(0) @map("commission_amount") @db.Decimal(15, 2) // 佣金金额
  insuranceFee       Decimal? @default(0) @map("insurance_fee") @db.Decimal(15, 2) // 保险费用
  additionalAmount   Decimal? @default(0) @map("additional_amount") @db.Decimal(15, 2) // 加项金额
  additionalTotal    Decimal? @default(0) @map("additional_total") @db.Decimal(15, 2) // 加项总额
  deductionAmount    Decimal? @default(0) @map("deduction_amount") @db.Decimal(15, 2) // 减项金额
  deductionTotal     Decimal? @default(0) @map("deduction_total") @db.Decimal(15, 2) // 减项总额
  receivedValue      Decimal? @default(0) @map("received_value") @db.Decimal(15, 2) // 已收货值
  unreceivedValue    Decimal? @default(0) @map("unreceived_value") @db.Decimal(15, 2) // 未收货值

  // 标识字段
  autoCreated   Boolean @default(false) @map("auto_created") // 自动生成标识
  invoiceFlag   String? @map("invoice_flag") // 发票标识
  billingFlag   String? @map("billing_flag") // 开票标识
  changeStatus  String? @map("change_status") // 变更状态
  confirmStatus String? @map("confirm_status") // 确认状态

  // 附件与备注
  remark String? // 备注

  // 时间戳
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // 关联关系
  items ShippingOrderItem[] @relation("ShippingOrderItems")

  @@index([code])
  @@index([status])
  @@index([planCode])
  @@index([customerId])
  @@index([expectedShippingDate])
  @@index([shippingDate])
  @@index([createdAt])
  @@map("shipping_orders")
}

