  warehouseOutDate DateTime? @map("warehouse_out_date") // 出仓日期

  // 拉柜信息
  isConvertedToContainer Boolean   @default(false) @map("is_converted_to_container") // 转拉柜标识
  expectedContainerDate  DateTime? @map("expected_container_date") // 预计拉柜时间

  // 开票信息
  invoiceStatus String? @map("invoice_status") // 开票状态

  // 分箱与标识
  isSeparateBox    Boolean @default(false) @map("is_separate_box") // 是否分箱
  isIncludeGift    Boolean @default(false) @map("is_include_gift") // 是否包含赠品
  isNeedProcessing Boolean @default(false) @map("is_need_processing") // 是否需要加工

  // 仓库信息
  warehouseCode String? @map("warehouse_code") // 仓库编号
  warehouseName String? @map("warehouse_name") // 仓库名称

  // 来源追溯
  sourceDetailId String? @map("source_detail_id") // 来源明细id
  sourceCode     String? @map("source_code") // 来源编号
  uniqueCode     String? @map("unique_code") // 唯一编号

  // 状态
  status String? @default("DRAFT") // 状态

  // 备注
  remark String? // 备注

  // 时间戳
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([shippingOrderId])
  @@index([productId])
  @@index([supplierId])
  @@index([customerId])
  @@index([purchaseContractCode])
  @@index([salesContractCode])
  @@map("shipping_order_items")
}
