generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                    String               @id @default(cuid())
  taxNumber             String?              @map("tax_number")
  customsCode           String?              @map("customs_code")
  officialSealImage     String?              @map("official_seal_image")
  abbreviation          String?
  isEnabled             Boolean              @default(true) @map("is_enabled")
  legalPerson           String?              @map("legal_person")
  fax                   String?
  phone                 String?
  adminEmail            String?              @map("admin_email")
  adminMobile           String?              @map("admin_mobile")
  adminName             String?              @map("admin_name")
  address               String?
  addressEn             String?              @map("address_en")
  businessLicenseNumber String?              @map("business_license_number")
  businessLicenseImage  String?              @map("business_license_image")
  nameEn                String?              @map("name_en")
  name                  String
  nature                CompanyNature        @default(FACTORY)
  unitAbbreviation      String?              @map("unit_abbreviation")
  createdBy             String?              @map("created_by")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedBy             String?              @map("updated_by")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  deletedAt             DateTime?            @map("deleted_at")
  bankAccounts          CompanyBankAccount[]

  @@map("companies")
}

model CompanyBankAccount {
  id            String    @id @default(cuid())
  companyId     String    @map("company_id")
  bankAddress   String?   @map("bank_address")
  companyNameCn String?   @map("company_name_cn")
  companyNameEn String?   @map("company_name_en")
  bankNameCn    String?   @map("bank_name_cn")
  bankNameEn    String?   @map("bank_name_en")
  bankAddressEn String?   @map("bank_address_en")
  accountNumber String?   @map("account_number")
  swiftCode     String?   @map("swift_code")
  isDefault     Boolean   @default(false) @map("is_default")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedBy     String?   @map("updated_by")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_bank_accounts")
}

model Region {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  countries Country[]

  @@map("regions")
}

model Country {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  regionId  String?   @map("region_id")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  region    Region?   @relation(fields: [regionId], references: [id])
  ports     Port[]

  @@index([regionId])
  @@map("countries")
}

model Port {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  nameEn    String?    @map("name_en")
  countryId String     @map("country_id")
  city      String?
  address   String?
  isCommon  Boolean    @default(false) @map("is_common")
  status    PortStatus @default(NORMAL)
  createdBy String?    @map("created_by")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedBy String?    @map("updated_by")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")
  country   Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@map("ports")
}

model Department {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  parentId  String?      @map("parent_id")
  orderNum  Int          @default(0) @map("order_num")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  products  Product[]
  users     SysUser[]    @relation("UserDepartment")

  @@index([parentId])
  @@map("departments")
}

model OrderRoute {
  id          String    @id @default(cuid())
  path        String
  status      String
  description String?
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedBy   String?   @map("updated_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  isCommon    Boolean   @default(false) @map("is_common")
  sortOrder   Int       @default(0) @map("sort_order")

  @@map("order_routes")
}

model OtherConfig {
  id          String            @id @default(cuid())
  name        String
  description String?
  orderNum    Int               @default(0) @map("order_num")
  createdBy   String?           @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedBy   String?           @map("updated_by")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")
  parameters  ConfigParameter[]

  @@map("other_configs")
}

model ConfigParameter {
  id          String      @id @default(cuid())
  configId    String      @map("config_id")
  name        String
  type        String
  elementType String?
  value       String?
  validation  String?
  orderNum    Int         @default(0) @map("order_num")
  config      OtherConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@map("config_parameters")
}

model Brand {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  nameEn        String?   @map("name_en")
  customerId    String?   @map("customer_id")
  customerCode  String?   @map("customer_code")
  customerName  String?   @map("customer_name")
  type          String?
  description   String?
  descriptionEn String?   @map("description_en")
  isCommon      Boolean   @default(false) @map("is_common")
  isSelfOwned   Boolean   @default(false) @map("is_self_owned")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedBy     String?   @map("updated_by")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  products      Product[]

  @@map("brands")
}

model ProductCategory {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  level        Int               @default(1)
  parentId     String?           @map("parent_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")
  codePrefix   String?           @map("code_prefix")
  serialLength Int               @default(3) @map("serial_length")
  parent       ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     ProductCategory[] @relation("CategoryTree")
  products     Product[]

  @@map("product_categories")
}

model HsCode {
  id            String    @id @default(cuid())
  code          String    @unique
  hsCode        String    @map("hs_code")
  name          String
  customsUnit   String    @map("customs_unit")
  taxRefundRate Decimal   @map("tax_refund_rate") @db.Decimal(5, 2)
  taxRate       Decimal?  @map("tax_rate") @db.Decimal(5, 2)
  remark        String?
  fullName      String?   @map("full_name")
  levyRate      Decimal?  @map("levy_rate") @db.Decimal(5, 2)
  secondUnit    String?   @map("second_unit")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedBy     String?   @map("updated_by")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  isCommon      Boolean   @default(false) @map("is_common")
  sortOrder     Int       @default(0) @map("sort_order")
  products      Product[]

  @@map("hs_codes")
}

model CustomerCategory {
  id        String             @id @default(cuid())
  code      String             @unique
  name      String
  parentId  String?            @map("parent_id")
  createdBy String?            @map("created_by")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedBy String?            @map("updated_by")
  updatedAt DateTime           @updatedAt @map("updated_at")
  deletedAt DateTime?          @map("deleted_at")
  sortOrder Int                @default(0) @map("sort_order")
  parent    CustomerCategory?  @relation("CustomerCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  CustomerCategory[] @relation("CustomerCategoryTree")
  customers Customer[]

  @@index([parentId])
  @@map("customer_categories")
}

model ExhibitionCategory {
  id         String    @id @default(cuid())
  name       String
  isDomestic Boolean   @default(false) @map("is_domestic")
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedBy  String?   @map("updated_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  isCommon   Boolean   @default(false) @map("is_common")
  sortOrder  Int       @default(0) @map("sort_order")

  @@map("exhibition_categories")
}

model CustomerSourceTag {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  isCommon  Boolean   @default(false) @map("is_common")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  sortOrder Int       @default(0) @map("sort_order")

  @@map("customer_source_tags")
}

model PackageMethod {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  nameEn    String?   @map("name_en")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  products  Product[]

  @@map("package_methods")
}

model Product {
  id                  String             @id @default(cuid())
  code                String             @unique
  barcode             String?
  name                String
  nameEn              String?            @map("name_en")
  productType         ProductType        @default(STANDARD) @map("product_type")
  baseProductId       String?            @map("base_product_id")
  customerId          String?            @map("customer_id")
  customerCode        String?            @map("customer_code")
  customerProductNo   String?            @map("customer_product_no")
  selfOwnedProductNo  String?            @map("self_owned_product_no")
  status              ProductStatus      @default(ACTIVE)
  description         String?
  descriptionEn       String?            @map("description_en")
  isSelfBrand         Boolean            @default(false) @map("is_self_brand")
  isAdvantage         Boolean            @default(false) @map("is_advantage")
  source              MaterialSource?
  material            String?
  accessoryMaterial   String?            @map("accessory_material")
  unit                String             @default("PCS")
  length              Decimal?           @db.Decimal(10, 2)
  width               Decimal?           @db.Decimal(10, 2)
  height              Decimal?           @db.Decimal(10, 2)
  netWeight           Decimal?           @map("net_weight") @db.Decimal(10, 3)
  unitProcessingFee   Decimal?           @map("unit_processing_fee") @db.Decimal(10, 2)
  processingNote      String?            @map("processing_note")
  salePrice           Decimal?           @map("sale_price") @db.Decimal(10, 2)
  companyPrice        Decimal?           @map("company_price") @db.Decimal(10, 2)
  isCustomsInspection Boolean            @default(false) @map("is_customs_inspection")
  customsNameCn       String?            @map("customs_name_cn")
  customsNameEn       String?            @map("customs_name_en")
  isAgent             Boolean            @default(false) @map("is_agent")
  isCommonAccessory   Boolean            @default(false) @map("is_common_accessory")
  approvalStatus      ApprovalStatus     @default(PENDING) @map("approval_status")
  isChanged           Boolean            @default(false) @map("is_changed")
  changeStatus        ChangeStatus?      @map("change_status")
  changeDeleted       Boolean            @default(false) @map("change_deleted")
  version             Int                @default(1)
  impactScope         String?            @map("impact_scope")
  processModelId      String?            @map("process_model_id")
  thumbnail           String?
  attachments         Json?
  images              Json?
  remark              String?
  autoCreated         Boolean            @default(false) @map("auto_created")
  customerProductId   String?            @map("customer_product_id")
  departmentId        String?            @map("department_id")
  brandId             String?            @map("brand_id")
  categoryId          String?            @map("category_id")
  hsCodeId            String?            @map("hs_code_id")
  packageMethodId     String?            @map("package_method_id")
  createdBy           String?            @map("created_by")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedBy           String?            @map("updated_by")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  deletedAt           DateTime?          @map("deleted_at")
  isOnShelf           Boolean            @default(false) @map("is_on_shelf")
  currency            String?            @default("USD")
  skuType             SkuType?           @map("sku_type")
  usedAsAccessory     ProductAccessory[] @relation("AccessoryProduct")
  accessories         ProductAccessory[] @relation("ProductAccessories")
  usedInBoms          ProductBom[]       @relation("ChildProduct")
  bomItems            ProductBom[]       @relation("ParentProduct")
  changeLogs          ProductChangeLog[]
  changeRequests      ProductChange[]
  productImages       ProductImage[]
  baseProduct         Product?           @relation("ProductInheritance", fields: [baseProductId], references: [id])
  derivedProducts     Product[]          @relation("ProductInheritance")
  brand               Brand?             @relation(fields: [brandId], references: [id])
  category            ProductCategory?   @relation(fields: [categoryId], references: [id])
  department          Department?        @relation(fields: [departmentId], references: [id])
  hsCode              HsCode?            @relation(fields: [hsCodeId], references: [id])
  packageMethod       PackageMethod?     @relation(fields: [packageMethodId], references: [id])

  @@index([productType])
  @@index([status])
  @@index([baseProductId])
  @@index([customerId])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductBom {
  id              String    @id @default(cuid())
  parentProductId String    @map("parent_product_id")
  childProductId  String    @map("child_product_id")
  quantity        Decimal   @db.Decimal(10, 3)
  version         Int       @default(1)
  productType     String?   @map("product_type")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedBy       String?   @map("updated_by")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  childProduct    Product   @relation("ChildProduct", fields: [childProductId], references: [id], onDelete: Cascade)
  parentProduct   Product   @relation("ParentProduct", fields: [parentProductId], references: [id], onDelete: Cascade)

  @@unique([parentProductId, childProductId])
  @@index([parentProductId])
  @@index([childProductId])
  @@map("product_boms")
}

model ProductImage {
  id            String    @id @default(cuid())
  productId     String    @map("product_id")
  /// 原始文件名 (用户上传时的名称)
  originalName  String    @map("original_name")
  /// 服务器存储路径 (相对于 uploads 目录)
  filePath      String    @map("file_path")
  /// 缩略图存储路径 (仅主图生成)
  thumbnailPath String?   @map("thumbnail_path")
  /// 是否为主图
  isPrimary     Boolean   @default(false) @map("is_primary")
  /// 排序号
  sortOrder     Int       @default(0) @map("sort_order")
  /// 文件大小 (字节)
  fileSize      Int?      @map("file_size")
  /// MIME 类型
  mimeType      String?   @map("mime_type")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedBy     String?   @map("updated_by")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductAccessory {
  id             String    @id @default(cuid())
  productId      String    @map("product_id")
  accessoryId    String    @map("accessory_id")
  productRatio   Decimal?  @map("product_ratio") @db.Decimal(10, 3)
  accessoryRatio Decimal?  @map("accessory_ratio") @db.Decimal(10, 3)
  description    String?
  remark         String?
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedBy      String?   @map("updated_by")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  accessory      Product   @relation("AccessoryProduct", fields: [accessoryId], references: [id], onDelete: Cascade)
  product        Product   @relation("ProductAccessories", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, accessoryId])
  @@index([productId])
  @@index([accessoryId])
  @@map("product_accessories")
}

model ProductChangeLog {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  version       Int
  changeType    String   @map("change_type")
  fieldName     String?  @map("field_name")
  oldValue      String?  @map("old_value")
  newValue      String?  @map("new_value")
  description   String?
  reason        String?
  changedBy     String   @map("changed_by")
  changedAt     DateTime @default(now()) @map("changed_at")
  changeDetails Json?    @map("change_details")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([changedAt])
  @@map("product_change_logs")
}

model ProductChange {
  id              String       @id @default(cuid())
  productId       String       @map("product_id")
  originalData    Json         @map("original_data")
  changeData      Json         @map("change_data")
  changeReason    String       @map("change_reason")
  changeStatus    ChangeStatus @default(PENDING) @map("change_status")
  requestedBy     String       @map("requested_by")
  approvedBy      String?      @map("approved_by")
  approvedAt      DateTime?    @map("approved_at")
  approvalComment String?      @map("approval_comment")
  createdBy       String       @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedBy       String?      @map("updated_by")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([changeStatus])
  @@map("product_changes")
}

model Supplier {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  nameEn               String?               @map("name_en")
  shortName            String?               @map("short_name")
  registeredCapital    Decimal?              @map("registered_capital") @db.Decimal(15, 2)
  legalRepresentative  String?               @map("legal_representative")
  mainBusiness         String?               @map("main_business")
  payableSupplierCode  String?               @map("payable_supplier_code")
  companyCity          String?               @map("company_city")
  factoryCity          String?               @map("factory_city")
  expressCity          String?               @map("express_city")
  factoryAddress       String?               @map("factory_address")
  companyAddress       String?               @map("company_address")
  expressAddress       String?               @map("express_address")
  businessLicenseNo    String?               @map("business_license_no")
  companyPhone         String?               @map("company_phone")
  fax                  String?
  isOverseas           Boolean               @default(false) @map("is_overseas")
  supplierType         SupplierType          @default(MANUFACTURER) @map("supplier_type")
  supplierLevel        SupplierLevel?        @map("supplier_level")
  stage                SupplierStage         @default(POTENTIAL)
  countryCode          String?               @map("country_code")
  currency             String?               @default("CNY")
  taxRate              Decimal?              @map("tax_rate") @db.Decimal(5, 2)
  invoiceType          InvoiceType?          @map("invoice_type")
  buyerList            Json?                 @map("buyer_list")
  buyer                String?
  isInternalEnterprise Boolean               @default(false) @map("is_internal_enterprise")
  internalEnterprisePk String?               @map("internal_enterprise_pk")
  isExpressCompany     Boolean               @default(false) @map("is_express_company")
  qualificationIds     Json?                 @map("qualification_ids")
  approvalStatus       ApprovalStatus        @default(PENDING) @map("approval_status")
  isFormal             Boolean               @default(false) @map("is_formal")
  formalTime           DateTime?             @map("formal_time")
  isEnabled            Boolean               @default(true) @map("is_enabled")
  attachments          Json?
  remark               String?
  financialInfo        Json?                 @map("financial_info")
  createdBy            String?               @map("created_by")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedBy            String?               @map("updated_by")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")
  bankAccounts         SupplierBankAccount[]
  paymentPlans         SupplierPaymentPlan[]
  quotations           SupplierQuotation[]

  @@index([code])
  @@index([stage])
  @@index([supplierType])
  @@index([approvalStatus])
  @@map("suppliers")
}

model SupplierBankAccount {
  id              String    @id @default(cuid())
  supplierId      String    @map("supplier_id")
  supplierVersion Int       @map("supplier_version")
  bankName        String    @map("bank_name")
  accountNumber   String    @map("account_number")
  branchAddress   String?   @map("branch_address")
  branchContact   String?   @map("branch_contact")
  bankCode        String?   @map("bank_code")
  isDefault       Boolean   @default(false) @map("is_default")
  version         Int       @default(1)
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedBy       String?   @map("updated_by")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  supplier        Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([isDefault])
  @@map("supplier_bank_accounts")
}

model SupplierQuotation {
  id            String         @id @default(cuid())
  supplierId    String         @map("supplier_id")
  productId     String?        @map("product_id")
  productCode   String?        @map("product_code")
  productName   String         @map("product_name")
  productSpec   String?        @map("product_spec")
  quotationNo   String         @unique @map("quotation_no")
  quotationDate DateTime       @map("quotation_date")
  validFrom     DateTime       @map("valid_from")
  validTo       DateTime       @map("valid_to")
  currency      String         @default("CNY")
  unitPrice     Decimal        @map("unit_price") @db.Decimal(15, 4)
  unit          String         @default("PCS")
  moq           Int?           @map("moq")
  leadTime      Int?           @map("lead_time")
  taxRate       Decimal?       @map("tax_rate") @db.Decimal(5, 2)
  paymentTerms  String?        @map("payment_terms")
  status        ApprovalStatus @default(PENDING)
  isActive      Boolean        @default(true) @map("is_active")
  remark        String?
  attachments   Json?
  createdBy     String?        @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedBy     String?        @map("updated_by")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([quotationNo])
  @@index([quotationDate])
