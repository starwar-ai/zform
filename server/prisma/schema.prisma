enum ShippingPlanStatus {
  DRAFT // 草稿
  PENDING // 待审核
  APPROVED // 已审核
  IN_PROGRESS // 执行中
  COMPLETED // 已完成
  CANCELLED // 已取消
}

// ==================== 出运计划单主表 ====================

model ShippingPlan {
  id String @id @default(cuid())

  // 基本信息
  code                 String             @unique // 编号
  status               ShippingPlanStatus @default(DRAFT) // 单据状态
  entryDate            DateTime?          @map("entry_date") // 录入日期
  expectedShippingDate DateTime?          @map("expected_shipping_date") // 预计出运时间
  orderLinkCode        String?            @map("order_link_code") // 订单链路编号
  salesContractCode    String?            @map("sales_contract_code") // 外销合同号

  // 唛头信息
  frontMark String? @map("front_mark") // 正面唛头
  sideMark  String? @map("side_mark") // 侧面唛头

  // 收货人/通知人
  consignee   String? // 收货人
  notifyParty String? @map("notify_party") // 通知人

  // 日期信息
  expectedDeliveryDate DateTime? @map("expected_delivery_date") // 预计交货日期
  customerDeliveryDate DateTime? @map("customer_delivery_date") // 客户交期

  // 人员信息
  salesPerson String? @map("sales_person") // 业务员
  buyer       String? // 采购员
  entryPerson String? @map("entry_person") // 录入人

  // 价格条款
  priceTerms      String? @map("price_terms") // 价格条款
  transportMethod String? @map("transport_method") // 运输方式

  // 金额统计
  purchaseTotal Decimal? @default(0) @map("purchase_total") @db.Decimal(15, 2) // 采购合计
  totalValue    Decimal? @default(0) @map("total_value") @db.Decimal(15, 2) // 货值合计

  // 出运国信息
  shippingCountryId     String? @map("shipping_country_id") // 出运国主键
  shippingCountryName   String? @map("shipping_country_name") // 出运国名称
  shippingCountryRegion String? @map("shipping_country_region") // 出运国区域

  // 出运口岸信息
  departurePortId   String? @map("departure_port_id") // 出运口岸主键
  departurePortName String? @map("departure_port_name") // 出运口岸名称

  // 贸易国别信息
  tradeCountryId     String? @map("trade_country_id") // 贸易国别主键
  tradeCountryName   String? @map("trade_country_name") // 贸易国别名称
  tradeCountryRegion String? @map("trade_country_region") // 贸易国别区域

  // 目的口岸信息
  destinationPortId   String? @map("destination_port_id") // 目的口岸主键
  destinationPortName String? @map("destination_port_name") // 目的口岸名称

  // 客户PO号
  customerPoNo String? @map("customer_po_no") // 客户PO号

  // 应收客户信息
  receivableCustomerId   String? @map("receivable_customer_id") // 应收客户主键
  receivableCustomerCode String? @map("receivable_customer_code") // 应收客户编号
  receivableCustomerName String? @map("receivable_customer_name") // 应收客户名称

  // 收货客户信息
  deliveryCustomerId String? @map("delivery_customer_id") // 收货客户主键

  // 外贸公司主体
  tradingCompanyId   String? @map("trading_company_id") // 外贸公司主体主键
  tradingCompanyName String? @map("trading_company_name") // 外贸公司主体名称

  // 柜型信息
  container20ft Int?     @default(0) @map("container_20ft") // 20尺柜
  container40ft Int?     @default(0) @map("container_40ft") // 40尺柜
  container40hq Int?     @default(0) @map("container_40hq") // 40尺高柜
  bulkCargo     Decimal? @map("bulk_cargo") @db.Decimal(10, 2) // 散货

  // 汇总统计
  totalQuantity    Decimal? @default(0) @map("total_quantity") @db.Decimal(10, 2) // 数量合计
  totalBoxes       Int?     @default(0) @map("total_boxes") // 箱数合计
  totalGrossWeight Decimal? @default(0) @map("total_gross_weight") @db.Decimal(10, 3) // 毛重合计
  totalNetWeight   Decimal? @default(0) @map("total_net_weight") @db.Decimal(10, 3) // 净重合计
  totalVolume      Decimal? @default(0) @map("total_volume") @db.Decimal(10, 3) // 体积合计

  // 附件与备注
  attachments Json? // 附件（JSON数组）
  remark      String? // 备注

  // 时间戳
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // 关联关系
  items ShippingPlanItem[] @relation("ShippingPlanItems")

  @@index([code])
  @@index([status])
  @@index([salesContractCode])
  @@index([receivableCustomerId])
  @@index([expectedShippingDate])
  @@index([createdAt])
  @@map("shipping_plans")
}

