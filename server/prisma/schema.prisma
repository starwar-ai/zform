  purchaseQuantity       Decimal? @map("purchase_quantity") @db.Decimal(10, 2) // 采购数量
  purchaseContractItemId String?  @map("purchase_contract_item_id") // 采购合同明细主键
  purchaseContractCode   String?  @map("purchase_contract_code") // 采购合同编号

